# Copy to .env.local and fill in with the values from `terraform output` (infra/).
# These are public identifiers, not secrets, but .env.local is gitignored anyway.
VITE_COGNITO_USER_POOL_ID=eu-west-1_xxxxxxxxx
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# Managed Login domain, without https://
VITE_COGNITO_DOMAIN=cloudbox-dev-xxxxxx.auth.eu-west-1.amazoncognito.com
# Base URL of the HTTP API (terraform output api_url), without a trailing slash
VITE_API_URL=https://xxxxxxxxxx.execute-api.eu-west-1.amazonaws.com
